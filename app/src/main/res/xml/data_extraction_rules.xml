<?xml version="1.0" encoding="utf-8"?>
<!-- Backup / device transfer (Android 12+). device_account.xml records which
     account THIS phone was registered to — never copy it to another phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="device_account.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="device_account.xml" />
    </device-transfer>
</data-extraction-rules>
