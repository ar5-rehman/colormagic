{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "site": "colormagic",
      "public": "hosting/public",
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        "**/.*"
      ]
    },
    {
      "site": "colormagic-555",
      "public": "hosting/public",
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        "**/.*"
      ]
    }
  ]
}
